{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Production capabilities exposed to the main application window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-backend-status",
    "allow-echo-text",
    "allow-task-lifecycle",
    "allow-runtime-probe",
    "allow-theme-state",
    "allow-layout-preferences",
    "allow-native-intent",
    "allow-document-analysis",
    "allow-settings",
    "allow-diagnostics"
  ]
}
