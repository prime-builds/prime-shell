{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Production capabilities exposed to the main application window.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://localhost:1420",
      "http://localhost:1420/*",
      "http://127.0.0.1:1420",
      "http://127.0.0.1:1420/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-backend-status",
    "allow-echo-text",
    "allow-task-lifecycle",
    "allow-runtime-probe",
    "allow-theme-state",
    "allow-layout-preferences",
    "allow-native-intent",
    "allow-document-analysis",
    "allow-settings",
    "allow-diagnostics",
    "allow-update"
  ]
}
