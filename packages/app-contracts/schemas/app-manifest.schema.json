{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prime-shell.local/schemas/app-manifest.schema.json",
  "title": "Application Template Manifest Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "appId",
    "productName",
    "bundleId",
    "executable",
    "version",
    "brand",
    "features",
    "operations",
    "window",
    "stateNamespace"
  ],
  "properties": {
    "appId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 2,
      "maxLength": 64
    },
    "productName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128
    },
    "bundleId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:\\.[a-z0-9-]+)+$",
      "minLength": 5,
      "maxLength": 128
    },
    "executable": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 2,
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accentColor", "publisher", "description"],
      "properties": {
        "accentColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "publisher": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "uniqueItems": true,
      "maxItems": 32
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9._-]+$"
      },
      "uniqueItems": true,
      "maxItems": 64
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "width", "height", "minWidth", "minHeight"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "width": {
          "type": "integer",
          "minimum": 400,
          "maximum": 7680
        },
        "height": {
          "type": "integer",
          "minimum": 300,
          "maximum": 4320
        },
        "minWidth": {
          "type": "integer",
          "minimum": 400,
          "maximum": 7680
        },
        "minHeight": {
          "type": "integer",
          "minimum": 300,
          "maximum": 4320
        }
      }
    },
    "stateNamespace": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$",
      "minLength": 2,
      "maxLength": 128
    }
  }
}
