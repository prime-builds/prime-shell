{
  "name": "prime-shell",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "24.16.0",
    "pnpm": "11.7.0"
  },
  "devDependencies": {
    "@wdio/cli": "^9.31.9",
    "@wdio/local-runner": "^9.31.9",
    "@wdio/mocha-framework": "^9.31.9",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-service": "^1.4.0",
    "ajv": "8.20.0",
    "expect-webdriverio": "^6.0.10"
  },
  "scripts": {
    "build": "pnpm --filter @prime-shell/desktop build",
    "contract:drift": "node scripts/verify/contract_drift.mjs",
    "contract:test": "node scripts/verify/contracts.mjs",
    "lint": "pnpm --filter @prime-shell/desktop lint",
    "test": "pnpm --filter @prime-shell/desktop test",
    "tokens:test": "pnpm --filter @prime-shell/design-tokens test",
    "tokens:typecheck": "pnpm --filter @prime-shell/design-tokens typecheck",
    "typecheck": "pnpm --filter @prime-shell/desktop typecheck",
    "verify:security": "node scripts/verify/security_baseline.mjs",
    "verify:baseline": "pnpm contract:test && pnpm contract:drift && pnpm verify:security && pnpm tokens:typecheck && pnpm tokens:test && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "sidecar:build": "bash scripts/build-sidecar/build-sidecar.sh",
    "sidecar:test": "python3 -m unittest discover -s services/python-backend/tests -v",
    "sidecar:verify": "python3 scripts/verify/packaged_echo.py",
    "native:verify": "bash scripts/verify/native_runtime.sh",
    "test:e2e": "wdio run wdio.conf.ts"
  }
}
